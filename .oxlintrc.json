{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_|^(leaseSuggestions|netdevParse|speedTier|tierFrom)$", "caughtErrorsIgnorePattern": "^_",
      "vars": "all", "ignoreRestSiblings": true }],
    "no-unused-expressions": "warn",
    "no-underscore-dangle": "off"
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "release-notes/**"]
}
