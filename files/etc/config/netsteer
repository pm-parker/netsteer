config netsteer 'state'
	option enabled '1'

config steering 'global'
	option rfs_sock_flow_entries '32768'

# 预设: all=全核(f) / pairs=收发分对(eth0=3,eth1=c) / off=0
config interface
	option iface 'eth0'
	option rps_cpus 'f'
	option xps_cpus 'f'
	option rfs_flow_cnt '4096'

config interface
	option iface 'eth1'
	option rps_cpus 'f'
	option xps_cpus 'f'
	option rfs_flow_cnt '4096'

config interface
	option iface 'pppoe-wan'
	option rps_cpus 'f'
	option xps_cpus '0'
	option rfs_flow_cnt '4096'
