config netsteer 'state'
	option enabled '1'

config steering 'global'
	option rfs_sock_flow_entries '32768'

# 命名 section (eth0/eth1/pppoe_wan), 供 LuCI 视图 uci.set 直写
config interface 'eth0'
	option iface 'eth0'
	option rps_cpus 'f'
	option xps_cpus 'f'
	option rfs_flow_cnt '4096'

config interface 'eth1'
	option iface 'eth1'
	option rps_cpus 'f'
	option xps_cpus 'f'
	option rfs_flow_cnt '4096'

config interface 'pppoe_wan'
	option iface 'pppoe-wan'
	option rps_cpus 'f'
	option xps_cpus '0'
	option rfs_flow_cnt '4096'
