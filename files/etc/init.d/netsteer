#!/bin/sh /etc/rc.common
# netsteer: 开机应用 RPS/RFS/XPS 转向 (首装自动探测生成配置)
START=70

start() {
	# 无配置时自动探测接口生成 (已有配置则跳过)
	/usr/bin/netsteer-detect >/dev/null 2>&1
	/usr/bin/netsteer-apply >/dev/null 2>&1
	# 游戏通道标记规则 + 整形脚本一致性兜底 (内部自判 enabled, 关闭态零动作)
	/usr/bin/netsteer-qos reapply >/dev/null 2>&1
	# 不抢网设备标记规则兜底 (v1.19 D22, 内部自判列表非空)
	/usr/bin/netsteer-bulk reapply >/dev/null 2>&1
	# 环境探测 (代理内核/DNS 观测面/出口探测目标) 后台预热, 结果缓存供 dnslog/probe 用
	(/usr/bin/netsteer-qos env >/dev/null 2>&1 &)
	# 场景判定守护 (幂等: pid 活着就不重复拉起; v1.18 判定下沉)
	if [ -f /tmp/netsteer/sense.pid ] && [ -d "/proc/$(cat /tmp/netsteer/sense.pid 2>/dev/null)" ]; then
		:
	else
		(/usr/bin/netsteer-qos sense-daemon >/dev/null 2>&1 &)
	fi
	ns_cron_ensure
}

ns_cron_file() {
	printf '%s\n' "${IPKG_INSTROOT:-}/etc/crontabs/root"
}

ns_cron_ensure() {
	local f line added=0
	f=$(ns_cron_file)
	mkdir -p "$(dirname "$f")" 2>/dev/null || return 0
	touch "$f" 2>/dev/null || return 0
	line='* * * * * /usr/bin/netsteer-check'
	grep -qxF "$line" "$f" 2>/dev/null || { echo "$line" >> "$f"; added=1; }
	line='37 4 * * 1 /usr/bin/netsteer-feed auto'
	grep -qxF "$line" "$f" 2>/dev/null || { echo "$line" >> "$f"; added=1; }
	[ "$added" = 1 ] && { /etc/init.d/cron restart >/dev/null 2>&1 || true; }
}

ns_cron_remove() {
	local f
	f=$(ns_cron_file)
	[ -f "$f" ] || return 0
	sed -i '\|/usr/bin/netsteer-check|d; \|/usr/bin/netsteer-feed|d' "$f" 2>/dev/null || true
	/etc/init.d/cron restart >/dev/null 2>&1 || true
}

boot() {
	# 网络起来后再应用 (hotplug 也会兜底)
	sleep 2
	start
}

restart() { stop; start; }
reload() { start; }

stop() {
	# v1.20: 真正停 daemon。旧版无 stop(), restart=start() 导致:
	# 1) 升级后旧 daemon 永生 (一直跑旧代码); 2) 泄漏的旧 daemon 无法经服务脚本回收。
	if [ -f /tmp/netsteer/sense.pid ]; then
		local dp
		dp=$(cat /tmp/netsteer/sense.pid 2>/dev/null)
		[ -n "$dp" ] && kill "$dp" 2>/dev/null
		rm -f /tmp/netsteer/sense.pid
	fi
	# 服务停掉后把原生 packet_steering 还回插件接管前的值。enable 不会调用 stop。
	if [ -x /usr/bin/netsteer-apply ]; then
		/usr/bin/netsteer-apply sync-packet-steering inactive >/dev/null 2>&1 || true
	fi
}

# rc.common 的 enable() 会先调用 disable()。这里的 disable 若无条件删 cron,
# enable 就会把刚挂上的 check/feed 行清掉。enable 自己补回链接和 cron。
enable() {
	NS_RC_FROM_ENABLE=1
	disable
	NS_RC_FROM_ENABLE=0
	local name d
	name=$(basename "${initscript:-$0}")
	d="${IPKG_INSTROOT:-}/etc/rc.d"
	mkdir -p "$d" 2>/dev/null || true
	[ -n "${START:-}" ] && ln -sfn "../init.d/$name" "$d/S${START}${name}"
	[ -n "${STOP:-}" ] && ln -sfn "../init.d/$name" "$d/K${STOP}${name}"
	ns_cron_ensure
}

disable() {
	local name d
	name=$(basename "${initscript:-$0}")
	d="${IPKG_INSTROOT:-}/etc/rc.d"
	rm -f "$d"/S[0-9][0-9]"$name" "$d"/K[0-9][0-9]"$name"
	if [ "${NS_RC_FROM_ENABLE:-0}" != 1 ]; then
		ns_cron_remove
	fi
}
