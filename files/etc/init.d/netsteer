#!/bin/sh /etc/rc.common
# netsteer: 开机应用 RPS/RFS/XPS 转向 (首装自动探测生成配置)
START=70

CRON_FILE=/etc/crontabs/root
CHECK_CRON='* * * * * /usr/bin/netsteer-check'

# cron 行幂等挂载: 已有则零动作, 新增才重启 cron (避免每次 start 都踢 crond)
ensure_check_cron() {
	[ -x /usr/bin/netsteer-check ] || return 0
	grep -qF 'netsteer-check' "$CRON_FILE" 2>/dev/null && return 0
	mkdir -p "$(dirname "$CRON_FILE")"
	echo "$CHECK_CRON" >> "$CRON_FILE" || return 1
	/etc/init.d/cron enable >/dev/null 2>&1
	/etc/init.d/cron restart >/dev/null 2>&1
	logger -t netsteer "已挂载 netsteer-check cron (每分钟对账/自愈)"
}

# 卸载时摘掉 cron 行 (留着会每分钟报 not found)
remove_check_cron() {
	[ -f "$CRON_FILE" ] || return 0
	grep -qF 'netsteer-check' "$CRON_FILE" 2>/dev/null || return 0
	grep -vF 'netsteer-check' "$CRON_FILE" > "$CRON_FILE.ns" 2>/dev/null &&
		mv "$CRON_FILE.ns" "$CRON_FILE"
	/etc/init.d/cron restart >/dev/null 2>&1
}

start() {
	# 对账/自愈 cron 挂载 (幂等): netsteer-check 承载过热保护、漂移自愈、数据集
	# 升级保护与 feed 周更挂载。apk 3.0.5 不执行 scripts hooks (v1.22.2 实测),
	# 此前没有任何入口调度它 — 这四项能力因此从未真正生效。
	ensure_check_cron
	# 无配置时自动探测接口生成 (已有配置则跳过)
	/usr/bin/netsteer-detect >/dev/null 2>&1
	/usr/bin/netsteer-apply >/dev/null 2>&1
	# 游戏通道标记规则 + 整形脚本一致性兜底 (内部自判 enabled, 关闭态零动作)
	/usr/bin/netsteer-qos reapply >/dev/null 2>&1
	# 不抢网设备标记规则兜底 (v1.19 D22, 内部自判列表非空)
	/usr/bin/netsteer-bulk reapply >/dev/null 2>&1
	# 环境探测 (代理内核/DNS 观测面/出口探测目标) 后台预热, 结果缓存供 dnslog/probe 用
	(/usr/bin/netsteer-qos env >/dev/null 2>&1 &)
	# 场景判定守护 (幂等: pid 活着就不重复拉起; v1.18 判定下沉)
	if [ -f /tmp/netsteer/sense.pid ] && [ -d "/proc/$(cat /tmp/netsteer/sense.pid 2>/dev/null)" ]; then
		:
	else
		(/usr/bin/netsteer-qos sense-daemon >/dev/null 2>&1 &)
	fi
}

boot() {
	# 网络起来后再应用 (hotplug 也会兜底)
	sleep 2
	start
}

restart() { stop; start; }
reload() { start; }

stop() {
	# v1.20: 真正停 daemon。旧版无 stop(), restart=start() 导致:
	# 1) 升级后旧 daemon 永生 (一直跑旧代码); 2) 泄漏的旧 daemon 无法经服务脚本回收。
	if [ -f /tmp/netsteer/sense.pid ]; then
		local dp
		dp=$(cat /tmp/netsteer/sense.pid 2>/dev/null)
		[ -n "$dp" ] && kill "$dp" 2>/dev/null
		rm -f /tmp/netsteer/sense.pid
	fi
}

# service disable (= 不再开机自启) 时同步摘掉 cron 行
disable() {
	remove_check_cron
	rm -f "/etc/rc.d/S${START}netsteer"
}
