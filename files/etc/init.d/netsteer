#!/bin/sh /etc/rc.common
# netsteer: 开机应用 RPS/RFS/XPS 转向 (首装自动探测生成配置)
START=70

start() {
	# 无配置时自动探测接口生成 (已有配置则跳过)
	/usr/bin/netsteer-detect >/dev/null 2>&1
	/usr/bin/netsteer-apply >/dev/null 2>&1
	# 游戏通道标记规则 + 整形脚本一致性兜底 (内部自判 enabled, 关闭态零动作)
	/usr/bin/netsteer-qos reapply >/dev/null 2>&1
	# 环境探测 (代理内核/DNS 观测面/出口探测目标) 后台预热, 结果缓存供 dnslog/probe 用
	(/usr/bin/netsteer-qos env >/dev/null 2>&1 &)
	# 场景判定守护 (幂等: pid 活着就不重复拉起; v1.18 判定下沉)
	if [ -f /tmp/netsteer/sense.pid ] && [ -d "/proc/$(cat /tmp/netsteer/sense.pid 2>/dev/null)" ]; then
		:
	else
		(/usr/bin/netsteer-qos sense-daemon >/dev/null 2>&1 &)
	fi
}

boot() {
	# 网络起来后再应用 (hotplug 也会兜底)
	sleep 2
	start
}

restart() { start; }
reload() { start; }
