#!/bin/sh
# netsteer-apply: 按 /etc/config/netsteer 应用 RPS/RFS/XPS/IRQ 亲和 (幂等)
# 运行后写 /tmp/netsteer/state.json 供 LuCI 页面读取 IRQ 现值
#
# 用法: netsteer-apply [apply|clear|preset <name>|auto]
#   apply (缺省)   按 uci 现值应用 (幂等, init/hotplug/tune/前端均用此模式)
#   clear          分核清零 (rps=0 xps=0, IRQ 不动) = 「系统默认」预设; off 模式用
#   preset <name>  先写回 uci 再应用 (uci 仍是唯一真相, 避免 netsteer-check 判漂移反复摆震)
#                  name: all / balanced (=全核, 同义) / off (=清零)
#   auto           同 preset all (首装探测默认)
. /lib/functions.sh

LOG_TAG=netsteer
log() { logger -t $LOG_TAG "$@"; echo "$@"; }

MODE="${1:-apply}"
PRESET=""
case "$MODE" in
	apply|clear) ;;
	preset) PRESET="${2:-}" ;;
	auto) PRESET='all' ;;
	*)
		echo "Usage: netsteer-apply [apply|clear|preset {all|balanced|off}|auto]" >&2
		exit 1
		;;
esac
case "${MODE}:${PRESET}" in
	preset:all|preset:balanced|preset:off|apply:*) ;;
	preset:*) echo "ERROR: unknown preset '$PRESET' (all|balanced|off)" >&2; exit 1 ;;
esac

NCPU=$(grep -c ^processor /proc/cpuinfo 2>/dev/null)
[ "$NCPU" -ge 1 ] 2>/dev/null || NCPU=1
FULL=$(printf '%x' $(( (1 << NCPU) - 1 )))

_sections() { uci -q show netsteer 2>/dev/null | sed -n 's/^netsteer\.\([^.=]*\)=interface$/\1/p'; }
_sec_for_dev() { # 已有节的 iface == $1 → 回节名; 否则回设备名转写
	local want="$1" s
	for s in $(_sections); do
		[ "$(uci -q get "netsteer.$s.iface")" = "$want" ] && { echo "$s"; return; }
	done
	echo "$want" | tr '-' '_'
}
_ensure_sec() { # 节不存在则建; 不覆盖已有选项
	uci -q get "netsteer.$1" >/dev/null 2>&1 || uci -q set "netsteer.$1=interface"
	uci -q set "netsteer.$1.iface='$2'"
	[ -n "$(uci -q get "netsteer.$1.rfs_flow_cnt" 2>/dev/null)" ] || uci -q set "netsteer.$1.rfs_flow_cnt='4096'"
}
preset_to_uci() { # 预设值写回 uci (uci 保持单一真相, 防 netsteer-check 判漂移摆震)
	local d n sec s vsec i=0 k changed=0
	case "$PRESET" in
		off)
			for s in $(_sections); do
				uci -q set "netsteer.$s.rps_cpus=0"
				uci -q set "netsteer.$s.xps_cpus=0"
				log "preset=off $s rps/xps=0 (IRQ 不动)"
				changed=1
			done
			;;
		all|balanced)
			# 物理口: 全核 RPS/XPS + IRQ 逐口错开 (与 netsteer-detect 同规则)
			for d in /sys/class/net/*; do
				[ -d "$d/device" ] || continue
				n=${d##*/}
				sec=$(_sec_for_dev "$n")
				k=$(( NCPU - 1 - i ))
				[ "$k" -lt 0 ] && k=$(( i % NCPU ))
				_ensure_sec "$sec" "$n"
				uci -q set "netsteer.$sec.rps_cpus='$FULL'"
				uci -q set "netsteer.$sec.xps_cpus='$FULL'"
				uci -q set "netsteer.$sec.irq_cpus='$(printf '%x' $(( 1 << k )))'"
				i=$(( i + 1 )); changed=1
				log "preset=$PRESET $sec($n) rps/xps=$FULL irq_cpu=$k"
			done
			# 虚拟口 (pppoe 等): 只给全核 RPS, 无硬件中断可摆
			for s in $(_sections); do
				vsec=$(uci -q get "netsteer.$s.iface" 2>/dev/null)
				[ -n "$vsec" ] && [ -d "/sys/class/net/$vsec" ] && [ ! -d "/sys/class/net/$vsec/device" ] || continue
				uci -q set "netsteer.$s.rps_cpus='$FULL'"
				log "preset=$PRESET $s($vsec) rps=$FULL (虚拟口, IRQ 不动)"
				changed=1
			done
			;;
	esac
	[ "$changed" = "1" ] && uci -q commit netsteer
	return 0
}

STATE_DIR=/tmp/netsteer
STATE_FILE=$STATE_DIR/state.json
STATE_TMP=$STATE_DIR/.state.tmp
STATE_TXT=$STATE_DIR/state.txt
mkdir -p "$STATE_DIR"
echo "{" > "$STATE_TMP"
: > "$STATE_TXT"

config_load netsteer
[ -n "$PRESET" ] && { preset_to_uci; config_load netsteer; }   # 重载: 后续 apply 读新值

config_get enabled state enabled 1
# clear 模式不受 enabled 开关限制 (否则 off 模式在禁用态下静默不生效)
[ "$enabled" = "1" ] || [ "$MODE" = "clear" ] || { log "disabled in uci, skip"; exit 0; }

# 全局 RFS
config_get entries global rfs_sock_flow_entries 32768
echo "$entries" > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null \
	&& log "rps_sock_flow_entries=$entries" || log "WARN: rps_sock_flow_entries 写入失败"

# 状态 JSON 追加: "iface":{"irq":"N","affinity":"X"} (逗号管理)
state_add() {
	local sep=""
	[ "$(wc -c < "$STATE_TMP")" -gt 2 ] && sep=","
	printf '%s"%s":{"irq":"%s","affinity":"%s"}' "$sep" "$1" "$2" "$3" >> "$STATE_TMP"
}

apply_iface() {
	local cfg="$1"
	local iface rps xps flow irq
	config_get iface "$cfg" iface
	[ -n "$iface" ] || return
	[ -d "/sys/class/net/$iface" ] || { log "skip $iface (不存在)"; return; }

	config_get rps "$cfg" rps_cpus 0
	config_get xps "$cfg" xps_cpus 0
	config_get flow "$cfg" rfs_flow_cnt 4096
	config_get irq "$cfg" irq_cpus ""
	# clear 模式: 分核清零 (= 「系统默认」预设), IRQ 不动
	if [ "$MODE" = "clear" ]; then
		rps=0; xps=0; irq=""
	fi

	for q in /sys/class/net/$iface/queues/rx-*; do
		[ -d "$q" ] || continue
		if [ ! -e "$q/rps_cpus" ]; then
			log "$iface rx($(basename $q)) rps 不适用 (驱动未暴露)"
			continue
		fi
		echo "$rps" > "$q/rps_cpus" 2>/dev/null \
			&& log "$iface rx($(basename $q)) rps=$rps" \
			|| log "WARN: $iface rps 写入失败"
		echo "$flow" > "$q/rps_flow_cnt" 2>/dev/null
	done
	for q in /sys/class/net/$iface/queues/tx-*; do
		[ -d "$q" ] || continue
		echo "$xps" > "$q/xps_cpus" 2>/dev/null
		# sysfs 幻影属性防御: stat 可见但 open ENOENT — 唯一可靠判据 = 写后回读
		if [ "$(cat "$q/xps_cpus" 2>/dev/null)" = "$xps" ]; then
			log "$iface tx($(basename $q)) xps=$xps"
		else
			log "$iface tx($(basename $q)) xps 不可写 (驱动不暴露/只读), 跳过"
		fi
	done

	# ---- IRQ 亲和 (单队列网卡: 内核实际只在掩码所含核中选一个应门) ----
	# 动态发现: MSI-X 设备优先, 兜底 /proc/interrupts 按设备名匹配 (IRQ 号跨启动会变)
	local irq_out="" n
	# msi_irqs/ 下的文件名 = IRQ 号 (文件内容是中断类型字符串如 "msix", 不能 cat)
	for n in /sys/class/net/$iface/device/msi_irqs/*; do
		[ -f "$n" ] || continue
		irq_out="$irq_out ${n##*/}"
	done
	[ -z "$(echo $irq_out | tr -d ' ')" ] && \
		irq_out=$(grep -E ":[[:space:][:digit:]]+ .*$iface\$" /proc/interrupts 2>/dev/null | cut -d: -f1 | tr -d ' ')

	local first=1 first_irq_no="" first_aff=""
	for n in $irq_out; do
		[ -n "$n" ] || continue
		local aff_file="/proc/irq/$n/smp_affinity"
		[ -e "$aff_file" ] || { log "$iface irq$n 不存在, 跳过"; continue; }
		if [ -n "$irq" ]; then
			local before after
			before=$(cat "$aff_file" 2>/dev/null)
			echo "$irq" > "$aff_file" 2>/dev/null
			after=$(cat "$aff_file" 2>/dev/null)
			# 写后回读判成败 (managed IRQ 可能拒写)
			if [ "$after" = "$irq" ]; then
				log "$iface irq$n irq=$irq"
			else
				log "WARN: $iface irq$n 写入失败 (before=$before after=$after), 保持原值"
			fi
		fi
		local cur
		cur=$(cat "$aff_file" 2>/dev/null)
		[ -z "$cur" ] && cur="?"
		if [ "$first" = "1" ]; then
			state_add "$iface" "$n" "$cur"
			first=0
			first_irq_no="$n"
			first_aff="$cur"
		else
			# 同设备多 IRQ: 后续中断号以 irqN 为键追加
			state_add "irq$n" "$n" "$cur"
		fi
	done

	# 通用状态行 (netsteer-check 比对用; 无硬编码接口/IRQ)
	printf 'netsteer %s %s rps %s' "$cfg" "$iface" "$rps" >> "$STATE_TXT"
	[ -n "$first_irq_no" ] && printf ' irq %s %s' "$first_irq_no" "$first_aff" >> "$STATE_TXT"
	echo >> "$STATE_TXT"
}

config_foreach apply_iface interface

echo "}" >> "$STATE_TMP"
mv "$STATE_TMP" "$STATE_FILE"
exit 0
