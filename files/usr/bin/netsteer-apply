#!/bin/sh
# netsteer-apply: 按 /etc/config/netsteer 应用 RPS/RFS/XPS/IRQ 亲和 (幂等)
# 运行后写 /tmp/netsteer/state.json 供 LuCI 页面读取 IRQ 现值
#
# 用法: netsteer-apply [apply|clear|preset <name>|auto]
#   apply (缺省)   按 uci 现值应用 (幂等, init/hotplug/tune/前端均用此模式)
#   clear          分核清零 (rps=0 xps=0, IRQ 不动) = 「系统默认」预设; off 模式用
#   preset <name>  先写回 uci 再应用 (uci 仍是唯一真相, 避免 netsteer-check 判漂移反复摆震)
#                  name: all / balanced (=全核, 同义) / off (=清零)
#   auto           同 preset all (首装探测默认)
#   sync-packet-steering active|auto|inactive
#     active: 显式 start, 清掉停止标记后把 packet_steering 置 0 并记住原值
#     auto:   hotplug/check/apply, 服务已 stop 时不再改它
#     inactive: 服务 stop, 提交成功后才按原值恢复并留下停止标记

PS_ORIGIN="${NS_PS_ORIGIN:-/etc/netsteer/packet_steering.origin}"
PS_STOPPED="${NS_PS_STOPPED:-/etc/netsteer/service.stopped}"
PS_LOCK="${NS_PS_LOCK:-$(dirname "$PS_ORIGIN")/packet_steering.lock}"

ps_get() {
	if uci -q get network.globals.packet_steering >/dev/null 2>&1; then
		uci -q get network.globals.packet_steering
		return 0
	fi
	if uci -q get network.@globals[0].packet_steering >/dev/null 2>&1; then
		uci -q get network.@globals[0].packet_steering
		return 0
	fi
	return 1
}

ps_commit() {
	uci commit network
}

ps_set() {
	if ! uci set network.globals.packet_steering="$1"; then
		uci set network.@globals[0].packet_steering="$1" || return 1
	fi
	ps_commit || return 1
}

ps_del() {
	uci delete network.globals.packet_steering 2>/dev/null
	uci delete network.@globals[0].packet_steering 2>/dev/null
	if ps_get >/dev/null 2>&1; then
		return 1
	fi
	ps_commit || return 1
}

# 快照必须是普通文件且格式完整。符号链接不打开, 避免读到任意目标。
ps_origin_kind() {
	[ -L "$PS_ORIGIN" ] && return 1
	[ -f "$PS_ORIGIN" ] || return 1
	_n=$(wc -l < "$PS_ORIGIN" | tr -d ' ')
	_a=$(sed -n '1p' "$PS_ORIGIN")
	_b=$(sed -n '2p' "$PS_ORIGIN")
	case "$_a" in
		set|stopping|stopped)
			[ "$_n" -eq 2 ] || return 1
			case "$_b" in ''|*[!0-9]*) return 1 ;; esac
			;;
		absent|stopping-absent|stopped-absent)
			[ "$_n" -eq 1 ] || return 1
			;;
		*) return 1 ;;
	esac
	printf '%s\n' "$_a"
}

ps_write_origin() {
	[ -L "$PS_ORIGIN" ] && return 1
	dir=$(dirname "$PS_ORIGIN")
	mkdir -p "$dir" || return 1
	[ -d "$dir" ] && [ ! -L "$dir" ] || return 1
	tmp=$(mktemp "$dir/.packet_steering.XXXXXX") || return 1
	if [ -n "${2:-}" ]; then
		printf '%s\n%s\n' "$1" "$2" > "$tmp" || { rm -f "$tmp"; return 1; }
	else
		printf '%s\n' "$1" > "$tmp" || { rm -f "$tmp"; return 1; }
	fi
	mv -f "$tmp" "$PS_ORIGIN" || { rm -f "$tmp"; return 1; }
	ps_origin_kind >/dev/null || return 1
}

ps_save_once() {
	if [ -L "$PS_ORIGIN" ]; then
		return 1
	fi
	if [ -e "$PS_ORIGIN" ]; then
		ps_origin_kind >/dev/null || return 1
		return 0
	fi
	if cur=$(ps_get); then
		ps_write_origin set "$cur" || return 1
	else
		ps_write_origin absent || return 1
	fi
}

ps_restore_from_origin() {
	kind=$(ps_origin_kind) || return 1
	val=$(sed -n '2p' "$PS_ORIGIN")
	case "$kind" in
		set|stopping|stopped)
			ps_set "$val" || return 1
			;;
		absent|stopping-absent|stopped-absent)
			ps_del || return 1
			;;
		*) return 1 ;;
	esac
}

ps_note_stopping() {
	kind=$(ps_origin_kind) || return 1
	val=$(sed -n '2p' "$PS_ORIGIN")
	case "$kind" in
		set|stopping|stopped) ps_write_origin stopping "$val" || return 1 ;;
		absent|stopping-absent|stopped-absent) ps_write_origin stopping-absent || return 1 ;;
		*) return 1 ;;
	esac
}

ps_mark_stopped() {
	dir=$(dirname "$PS_STOPPED")
	mkdir -p "$dir" || return 1
	[ -d "$dir" ] || return 1
	tmp=$(mktemp "$dir/.service.stopped.XXXXXX") || return 1
	printf 'stopped\n' > "$tmp" || { rm -f "$tmp"; return 1; }
	mv -f "$tmp" "$PS_STOPPED" || { rm -f "$tmp"; return 1; }
}

ps_hold() {
	[ -f "$PS_STOPPED" ] && [ ! -L "$PS_STOPPED" ] && return 0
	if [ -L "$PS_ORIGIN" ]; then
		return 0
	fi
	if [ -e "$PS_ORIGIN" ]; then
		kind=$(ps_origin_kind) || return 0
		case "$kind" in
			stopping|stopping-absent|stopped|stopped-absent) return 0 ;;
		esac
	fi
	return 1
}

ps_force_off() {
	# 停止中或已停止: 自动路径不得再把 packet_steering 写成 0
	ps_hold && return 0
	ps_save_once || return 1
	cur=$(ps_get 2>/dev/null || true)
	if [ "$cur" != "0" ]; then
		ps_set 0 || return 1
		logger -t netsteer "已关闭原生 packet_steering, 防止与 netsteer 互相覆写 RPS/IRQ" 2>/dev/null || true
	fi
}

ps_stop() {
	if [ -L "$PS_ORIGIN" ] || { [ -e "$PS_ORIGIN" ] && ! ps_origin_kind >/dev/null; }; then
		return 1
	fi
	if [ ! -e "$PS_ORIGIN" ] && [ ! -L "$PS_ORIGIN" ]; then
		if cur=$(ps_get); then
			ps_write_origin stopped "$cur" || return 1
		else
			ps_write_origin stopped-absent || return 1
		fi
	else
		ps_note_stopping || return 1
		ps_restore_from_origin || return 1
	fi
	ps_mark_stopped || return 1
	rm -f "$PS_ORIGIN" || return 1
}

ps_start() {
	if [ -L "$PS_ORIGIN" ] || { [ -e "$PS_ORIGIN" ] && ! ps_origin_kind >/dev/null; }; then
		return 1
	fi
	if [ -e "$PS_ORIGIN" ]; then
		kind=$(ps_origin_kind) || return 1
		val=$(sed -n '2p' "$PS_ORIGIN")
		case "$kind" in
			absent|stopping-absent|stopped-absent) remember=absent ;;
			*) remember="$val" ;;
		esac
	else
		if cur=$(ps_get); then
			remember="$cur"
		else
			remember=absent
		fi
	fi
	if [ ! -e "$PS_ORIGIN" ] && [ ! -L "$PS_ORIGIN" ]; then
		if [ "$remember" = "absent" ]; then
			ps_write_origin absent || return 1
		else
			ps_write_origin set "$remember" || return 1
		fi
	fi
	ps_set 0 || return 1
	case "$(ps_origin_kind)" in
		stopping|stopped) ps_write_origin set "$remember" || return 1 ;;
		stopping-absent|stopped-absent) ps_write_origin absent || return 1 ;;
	esac
	rm -f "$PS_STOPPED" || return 1
}

ps_with_lock() {
	if [ -L "$PS_LOCK" ]; then
		return 1
	fi
	dir=$(dirname "$PS_LOCK")
	if [ -L "$dir" ]; then
		return 1
	fi
	mkdir -p "$dir" || return 1
	[ -d "$dir" ] || return 1
	command -v flock >/dev/null 2>&1 || return 1
	exec 9>>"$PS_LOCK" || return 1
	if [ -L "$PS_LOCK" ]; then
		return 1
	fi
	flock -w "${NS_PS_LOCK_WAIT:-20}" 9 || return 1
	"$@"
	_rc=$?
	flock -u 9 2>/dev/null || true
	return $_rc
}

if [ "${1:-}" = "sync-packet-steering" ]; then
	case "${2:-}" in
		active) ps_with_lock ps_start || exit 1 ;;
		auto) ps_with_lock ps_force_off || exit 1 ;;
		inactive) ps_with_lock ps_stop || exit 1 ;;
		*) echo "Usage: netsteer-apply sync-packet-steering active|auto|inactive" >&2; exit 1 ;;
	esac
	exit 0
fi

. /lib/functions.sh

LOG_TAG=netsteer
log() { logger -t $LOG_TAG "$@"; echo "$@"; }

MODE="${1:-apply}"
PRESET=""
case "$MODE" in
	apply|clear) ;;
	preset) PRESET="${2:-}" ;;
	auto) PRESET='all' ;;
	*)
		echo "Usage: netsteer-apply [apply|clear|preset {all|balanced|off}|auto]" >&2
		exit 1
		;;
esac
case "${MODE}:${PRESET}" in
	preset:all|preset:balanced|preset:off|apply:*) ;;
	preset:*) echo "ERROR: unknown preset '$PRESET' (all|balanced|off)" >&2; exit 1 ;;
esac

NCPU=$(grep -c ^processor /proc/cpuinfo 2>/dev/null)
[ "$NCPU" -ge 1 ] 2>/dev/null || NCPU=1
FULL=$(printf '%x' $(( (1 << NCPU) - 1 )))

_sections() { uci -q show netsteer 2>/dev/null | sed -n 's/^netsteer\.\([^.=]*\)=interface$/\1/p'; }
_sec_for_dev() { # 已有节的 iface == $1 → 回节名; 否则回设备名转写
	local want="$1" s
	for s in $(_sections); do
		[ "$(uci -q get "netsteer.$s.iface")" = "$want" ] && { echo "$s"; return; }
	done
	echo "$want" | tr '-' '_'
}
_ensure_sec() { # 节不存在则建; 不覆盖已有选项
	uci -q get "netsteer.$1" >/dev/null 2>&1 || uci -q set "netsteer.$1=interface"
	uci -q set "netsteer.$1.iface='$2'"
	[ -n "$(uci -q get "netsteer.$1.rfs_flow_cnt" 2>/dev/null)" ] || uci -q set "netsteer.$1.rfs_flow_cnt='4096'"
}
preset_to_uci() { # 预设值写回 uci (uci 保持单一真相, 防 netsteer-check 判漂移摆震)
	local d n sec s vsec i=0 k changed=0
	case "$PRESET" in
		off)
			for s in $(_sections); do
				uci -q set "netsteer.$s.rps_cpus=0"
				uci -q set "netsteer.$s.xps_cpus=0"
				log "preset=off $s rps/xps=0 (IRQ 不动)"
				changed=1
			done
			;;
		all|balanced)
			# 物理口: 全核 RPS/XPS + IRQ 逐口错开 (与 netsteer-detect 同规则)
			for d in /sys/class/net/*; do
				[ -d "$d/device" ] || continue
				n=${d##*/}
				sec=$(_sec_for_dev "$n")
				k=$(( NCPU - 1 - i ))
				[ "$k" -lt 0 ] && k=$(( i % NCPU ))
				_ensure_sec "$sec" "$n"
				uci -q set "netsteer.$sec.rps_cpus='$FULL'"
				uci -q set "netsteer.$sec.xps_cpus='$FULL'"
				uci -q set "netsteer.$sec.irq_cpus='$(printf '%x' $(( 1 << k )))'"
				i=$(( i + 1 )); changed=1
				log "preset=$PRESET $sec($n) rps/xps=$FULL irq_cpu=$k"
			done
			# 虚拟口 (pppoe 等): 只给全核 RPS, 无硬件中断可摆
			for s in $(_sections); do
				vsec=$(uci -q get "netsteer.$s.iface" 2>/dev/null)
				[ -n "$vsec" ] && [ -d "/sys/class/net/$vsec" ] && [ ! -d "/sys/class/net/$vsec/device" ] || continue
				uci -q set "netsteer.$s.rps_cpus='$FULL'"
				log "preset=$PRESET $s($vsec) rps=$FULL (虚拟口, IRQ 不动)"
				changed=1
			done
			;;
	esac
	[ "$changed" = "1" ] && uci -q commit netsteer
	return 0
}

STATE_DIR=/tmp/netsteer
STATE_FILE=$STATE_DIR/state.json
STATE_TMP=$STATE_DIR/.state.json.$$
STATE_TXT=$STATE_DIR/state.txt
STATE_TXT_TMP=$STATE_DIR/.state.txt.$$
mkdir -p "$STATE_DIR"
trap 'rm -f "$STATE_TMP" "$STATE_TXT_TMP"' EXIT
echo "{" > "$STATE_TMP"
: > "$STATE_TXT_TMP"

config_load netsteer
[ -n "$PRESET" ] && { preset_to_uci; config_load netsteer; }   # 重载: 后续 apply 读新值

config_get enabled state enabled 1
# 服务 stop 之后保持已恢复的 packet_steering, 直到 init start 明确清掉停止标记。
# 接管态才压成 0; 快照写失败则不改配置。禁用 / clear 在服务仍运行时按快照恢复。
if [ "$enabled" = "1" ] && [ "$MODE" != "clear" ]; then
	ps_with_lock ps_force_off || exit 1
else
	ps_with_lock ps_stop || exit 1
fi
# clear 模式不受 enabled 开关限制 (否则 off 模式在禁用态下静默不生效)
[ "$enabled" = "1" ] || [ "$MODE" = "clear" ] || { log "disabled in uci, skip"; exit 0; }

# 全局 RFS
config_get entries global rfs_sock_flow_entries 32768
echo "$entries" > /proc/sys/net/core/rps_sock_flow_entries 2>/dev/null \
	&& log "rps_sock_flow_entries=$entries" || log "WARN: rps_sock_flow_entries 写入失败"

# 状态 JSON 追加: "iface":{"irq":"N","affinity":"X"} (逗号管理)
state_add() {
	local sep=""
	[ "$(wc -c < "$STATE_TMP")" -gt 2 ] && sep=","
	printf '%s"%s":{"irq":"%s","affinity":"%s"}' "$sep" "$1" "$2" "$3" >> "$STATE_TMP"
}

apply_iface() {
	local cfg="$1"
	local iface rps xps flow irq
	config_get iface "$cfg" iface
	[ -n "$iface" ] || return
	[ -d "/sys/class/net/$iface" ] || { log "skip $iface (不存在)"; return; }

	config_get rps "$cfg" rps_cpus 0
	config_get xps "$cfg" xps_cpus 0
	config_get flow "$cfg" rfs_flow_cnt 4096
	config_get irq "$cfg" irq_cpus ""
	# clear 模式: 分核清零 (= 「系统默认」预设), IRQ 不动
	if [ "$MODE" = "clear" ]; then
		rps=0; xps=0; irq=""
	fi

	for q in /sys/class/net/$iface/queues/rx-*; do
		[ -d "$q" ] || continue
		if [ ! -e "$q/rps_cpus" ]; then
			log "$iface rx($(basename $q)) rps 不适用 (驱动未暴露)"
			continue
		fi
		echo "$rps" > "$q/rps_cpus" 2>/dev/null \
			&& log "$iface rx($(basename $q)) rps=$rps" \
			|| log "WARN: $iface rps 写入失败"
		echo "$flow" > "$q/rps_flow_cnt" 2>/dev/null
	done
	for q in /sys/class/net/$iface/queues/tx-*; do
		[ -d "$q" ] || continue
		echo "$xps" > "$q/xps_cpus" 2>/dev/null
		# sysfs 幻影属性防御: stat 可见但 open ENOENT — 唯一可靠判据 = 写后回读
		if [ "$(cat "$q/xps_cpus" 2>/dev/null)" = "$xps" ]; then
			log "$iface tx($(basename $q)) xps=$xps"
		else
			log "$iface tx($(basename $q)) xps 不可写 (驱动不暴露/只读), 跳过"
		fi
	done

	# ---- IRQ 亲和 (单队列网卡: 内核实际只在掩码所含核中选一个应门) ----
	# 动态发现: MSI-X 设备优先, 兜底 /proc/interrupts 按设备名匹配 (IRQ 号跨启动会变)
	local irq_out="" n
	# msi_irqs/ 下的文件名 = IRQ 号 (文件内容是中断类型字符串如 "msix", 不能 cat)
	for n in /sys/class/net/$iface/device/msi_irqs/*; do
		[ -f "$n" ] || continue
		irq_out="$irq_out ${n##*/}"
	done
	[ -z "$(echo $irq_out | tr -d ' ')" ] && \
		irq_out=$(grep -E ":[[:space:][:digit:]]+ .*$iface\$" /proc/interrupts 2>/dev/null | cut -d: -f1 | tr -d ' ')

	local first=1 first_irq_no="" first_aff=""
	for n in $irq_out; do
		[ -n "$n" ] || continue
		local aff_file="/proc/irq/$n/smp_affinity"
		[ -e "$aff_file" ] || { log "$iface irq$n 不存在, 跳过"; continue; }
		if [ -n "$irq" ]; then
			local before after
			before=$(cat "$aff_file" 2>/dev/null)
			echo "$irq" > "$aff_file" 2>/dev/null
			after=$(cat "$aff_file" 2>/dev/null)
			# 写后回读判成败 (managed IRQ 可能拒写)
			if [ "$after" = "$irq" ]; then
				log "$iface irq$n irq=$irq"
			else
				log "WARN: $iface irq$n 写入失败 (before=$before after=$after), 保持原值"
			fi
		fi
		local cur
		cur=$(cat "$aff_file" 2>/dev/null)
		[ -z "$cur" ] && cur="?"
		if [ "$first" = "1" ]; then
			state_add "$iface" "$n" "$cur"
			first=0
			first_irq_no="$n"
			first_aff="$cur"
		else
			# 同设备多 IRQ: 后续中断号以 irqN 为键追加
			state_add "irq$n" "$n" "$cur"
		fi
	done

	# 通用状态行 (netsteer-check 比对用; 无硬编码接口/IRQ)
	printf 'netsteer %s %s rps %s' "$cfg" "$iface" "$rps" >> "$STATE_TXT_TMP"
	[ -n "$first_irq_no" ] && printf ' irq %s %s' "$first_irq_no" "$first_aff" >> "$STATE_TXT_TMP"
	echo >> "$STATE_TXT_TMP"
}

config_foreach apply_iface interface

echo "}" >> "$STATE_TMP"
mv "$STATE_TMP" "$STATE_FILE"
mv "$STATE_TXT_TMP" "$STATE_TXT"
exit 0
