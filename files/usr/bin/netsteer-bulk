#!/bin/sh
# netsteer-bulk: 设备级带宽仲裁 — "不抢网设备" (设备级 DSCP CS1 → cake bulk tin, v1.19 / D22)
#
# 原理 (与 netsteer-qos 游戏通道 D7 对称: 那是升优先级 cs4→video, 这是降优先级 cs1→bulk):
#   上行: nft forward 钩子  ip saddr <dev> dscp set cs1 → WAN cake bulk tin (thresh≈带宽/16)
#   下行: nft netdev ingress 钩子 ip daddr <dev> dscp set cs1 → ifb4<wan> cake bulk tin
#   cake diffserv3/4 均有 bulk tin; besteffort 无 tin (标记无害, status 如实上报 cake 模式)
#   不切 SQM 脚本 — 标记对现有整形配置零侵入
#
# 用法: netsteer-bulk add <ip> | remove <ip> | list | status | off | reapply | migrate [--apply]
#
# 互斥 (D22): 同一设备不可同时在游戏通道(netsteer.qos.device)与本列表 — add 时校验拒绝

. /lib/functions.sh

LOG_TAG=netsteer
TABLE=netsteer_bulk
RULES=/tmp/netsteer/bulk-rules.nft
LOADERR=/tmp/netsteer/bulk-nft.err

log() { logger -t $LOG_TAG "bulk: $@"; }

qos_get() { # $1=option $2=default
	config_load netsteer 2>/dev/null
	config_get v "qos" "$1" "$2"
	echo "$v"
}

valid_ip() {
	echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	local o
	for o in $(echo "$1" | tr '.' ' '); do
		[ "$o" -le 255 ] 2>/dev/null || return 1
	done
	case "$1" in
		192.168.*.*|10.*.*.*|172.1[6-9].*.*|172.2[0-9].*.*|172.3[01].*.*) return 0;;
		*) return 1;;
	esac
}

sqm_section() {
	uci -q show sqm 2>/dev/null | grep -E "=queue$|=sqm$" | head -1 | cut -d. -f2 | cut -d= -f1
}
wan_dev() {
	local sec=$(sqm_section)
	uci -q get sqm.$sec.interface 2>/dev/null || echo pppoe-wan
}
cake_have() { grep -q '^sch_cake' /proc/modules 2>/dev/null; }

ensure_section() {
	uci -q get netsteer.qos >/dev/null 2>&1 || { uci set netsteer.qos='qos'; uci commit netsteer; }
}

devices_get() { # 输出空格分隔 IP 列表 (uci get 对 list 返回单行空格分隔)
	uci -q get netsteer.qos.bulk_devices 2>/dev/null || echo ""
}

# ---- nft 规则生成 (纯函数: 输出到 stdout, 单测可断言) ----
emit_rules() { # $1=空格分隔设备列表  $2=wan dev
	local devs="$1" wan="$2"
	echo "table inet $TABLE {"
	echo "	chain mark_fwd {"
	echo "		type filter hook forward priority -140; policy accept;"
	for ip in $devs; do
		echo "		ip saddr $ip ip dscp set cs1 counter comment \"netsteer bulk up\""
	done
	echo "	}"
	echo "	chain mark_ing {"
	# ingress 钩子挂在具体接口上, 建链必须带 device (nftables wiki / 内核
	# NFTA_HOOK_DEV); 缺 device 时内核返回 EOPNOTSUPP, 整表加载失败。
	echo "		type filter hook ingress device \"$wan\" priority -440; policy accept;"
	for ip in $devs; do
		echo "		ip daddr $ip ip dscp set cs1 counter comment \"netsteer bulk down\""
	done
	echo "	}"
	echo "}"
}

# ---- nft 标记规则 (绝对幂等: 整表删除重建) ----
write_rules() {
	local devs="$(devices_get)" err
	mkdir -p /tmp/netsteer
	nft list table inet $TABLE >/dev/null 2>&1 && nft delete table inet $TABLE >/dev/null 2>&1
	[ -n "$devs" ] || { rm -f "$RULES" "$LOADERR"; return 0; }
	emit_rules "$devs" "$(wan_dev)" > "$RULES"
	# 加载错误必须留痕: 此前 2>/dev/null 吞掉 stderr, 而 rules_active() 只看
	# 表是否存在 → ingress 链建不起来时 UI 仍显示"已生效"。
	err=$(nft -f "$RULES" 2>&1)
	if [ -n "$err" ]; then
		printf '%s\n' "$err" > "$LOADERR"
		log "WARN: nft 加载有错: $err"
		return 1
	fi
	rm -f "$LOADERR"
	return 0
}
remove_rules() {
	nft delete table inet $TABLE >/dev/null 2>&1
	rm -f "$RULES" "$LOADERR"
}
rules_active() {
	# 表存在且 ingress 链真的在 → 才算生效
	nft list table inet $TABLE 2>/dev/null | grep -q 'hook ingress' && echo 1 || echo 0
}

# ---- 动作 ----
bulk_add() { # $1=device ip
	ensure_section
	local ip="$1"
	valid_ip "$ip" || { log "ERR: 非法内网 IP '$ip'"; echo "ERR: invalid ip"; exit 1; }
	# 互斥: 游戏通道占用中
	if [ "$(qos_get enabled 0)" = "1" ] && [ "$(qos_get device '')" = "$ip" ]; then
		log "ERR: $ip 在游戏通道中, 先关闭游戏通道再加入不抢网"
		echo "ERR: game-conflict"; exit 1
	fi
	local cur="$(devices_get)"
	case " $cur " in *" $ip "*) echo "OK: already $ip"; return 0;; esac
	cake_have || log "WARN: kmod-sch-cake 未加载, 标记暂无整形效果 (安装 SQM 后生效)"
	uci add_list netsteer.qos.bulk_devices="$ip"
	uci commit netsteer
	write_rules
	log "ADD: $ip → cs1 (up:forward + down:ingress), 设备数 $(echo $cur $ip | wc -w)"
	echo "OK: add $ip"
}

bulk_remove() { # $1=device ip
	ensure_section
	local ip="$1"
	valid_ip "$ip" || { echo "ERR: invalid ip"; exit 1; }
	local cur="$(devices_get)"
	case " $cur " in *" $ip "*) ;; *) echo "OK: not-in-list $ip"; return 0;; esac
	uci del_list netsteer.qos.bulk_devices="$ip"
	uci commit netsteer
	write_rules
	log "REMOVE: $ip (剩余 $(devices_get | wc -w) 台)"
	echo "OK: remove $ip"
}

bulk_off() {
	ensure_section
	while [ -n "$(devices_get)" ]; do
		uci del_list netsteer.qos.bulk_devices="$(devices_get | awk '{print $1}')"
		uci commit netsteer
	done
	remove_rules
	log "OFF: 不抢网列表已清空"
	echo "OK: off"
}

bulk_reapply() { # boot/hotplug 兜底: 列表非空才动作, 静默
	local devs="$(devices_get)"
	[ -n "$devs" ] || exit 0
	write_rules
	log "REAPPLY: $(echo $devs | wc -w) 台"
}

bulk_list() {
	local devs="$(devices_get)"
	for ip in $devs; do echo "$ip"; done
	[ -n "$devs" ] || echo "(empty)"
}

bulk_status() {
	ensure_section
	local devs="$(devices_get)"
	local wan="$(wan_dev)"
	local up_mode="$(tc qdisc show dev "$wan" 2>/dev/null | grep -oE 'diffserv[0-9]|besteffort' | head -1)"
	local dn_mode="$(tc qdisc show dev "ifb4$wan" 2>/dev/null | grep -oE 'diffserv[0-9]|besteffort' | head -1)"
	# nft counter 汇总 (标记包量, 供 UI 展示"已让路流量")
	local pkts=0
	if [ "$(rules_active)" = "1" ]; then
		pkts=$(nft list table inet $TABLE 2>/dev/null | grep -oE 'packets [0-9]+' | awk '{s+=$2} END{print s+0}')
	fi
	local j="[" i=0
	for ip in $devs; do
		[ "$i" -gt 0 ] && j="$j,"
		j="$j\"$ip\""; i=$((i+1))
	done
	j="$j]"
	# nft 加载失败原因随 status 上报, 前端才能把"规则没装上"说清楚
	local nfterr=""
	[ -s "$LOADERR" ] && nfterr=$(head -1 "$LOADERR" | sed 's/\\/\\\\/g; s/"/\\"/g')
	echo "{\"devices\":$j,\"active\":$(rules_active),\"count\":$i,\"pkts\":$pkts,\"cake_up\":\"${up_mode:-none}\",\"cake_down\":\"${dn_mode:-none}\",\"wan\":\"$wan\",\"nft_error\":\"$nfterr\",\"game_device\":\"$(qos_get device -)\",\"game_enabled\":$(qos_get enabled 0)}"
}

# ---- 存量手工规则迁移检测 (D22: 部署时检测 /etc/nftables.d/ 手工 CS1 规则) ----
bulk_migrate() { # 输出 JSON {found:[ip],files:[path]}; --apply 把 found 迁入 bulk_devices
	local found="" files="" ip f
	for f in /etc/nftables.d/*.nft; do
		[ -f "$f" ] || continue
		# 兼容符号名 cs1 与数值 8 两种写法 (CS1=DSF 8); 边界防 set 80 类误匹配
		grep -qE 'dscp set (cs1|8)( |$)' "$f" 2>/dev/null || continue
		files="$files $f"
		for ip in $(grep -oE 'ip saddr [0-9.]+' "$f" 2>/dev/null | awk '{print $3}' | sort -u); do
			valid_ip "$ip" || continue
			case " $found " in *" $ip "*) ;; *) found="$found $ip";; esac
		done
	done
	if [ "$1" = "--apply" ]; then
		ensure_section
		local n=0
		for ip in $found; do
			case " $(devices_get) " in *" $ip "*) ;; *) uci add_list netsteer.qos.bulk_devices="$ip"; n=$((n+1));; esac
		done
		[ "$n" -gt 0 ] && { uci commit netsteer; write_rules; }
		log "MIGRATE: 迁入 $n 台 (手工规则文件未删, 确认生效后手动移除)"
		for ip in $found; do echo "migrated: $ip"; done
		echo "OK: migrate $n"
		return
	fi
	local jf="[" i=0
	for ip in $found; do
		[ "$i" -gt 0 ] && jf="$jf,"
		jf="$jf\"$ip\""; i=$((i+1))
	done
	jf="$jf]"
	local jj="[" i=0
	for f in $files; do
		[ "$i" -gt 0 ] && jj="$jj,"
		jj="$jj\"$f\""; i=$((i+1))
	done
	jj="$jj]"
	echo "{\"found\":$jf,\"files\":$jj}"
}

# v1.22.1: 设备列表写操作前自动快照
case "$1" in
	add|remove|off|reapply) /usr/bin/netsteer-snapshot auto "bulk-$1" >/dev/null 2>&1 ;;
esac

case "$1" in
add)     shift; bulk_add "$@";;
remove)  shift; bulk_remove "$@";;
list)    bulk_list;;
status)  bulk_status;;
off)     bulk_off;;
reapply) bulk_reapply;;
migrate) shift; bulk_migrate "$@";;
*)       echo "usage: $0 add <ip> | remove <ip> | list | status | off | reapply | migrate [--apply]"; exit 1;;
esac
