#!/bin/sh
# NetSteer 远程数据集更新 (D11)
#
# 子命令:
#   status    本地数据集状态 (版本/文件校验)
#   check     拉远程 manifest 比对 (不落地)
#   update    下载+校验+原子替换 (失败保留现状)
#   rollback  回退到上一版本 (.bak)
#
# 设计约束 (通用家庭, D9):
#   - 零 jq 依赖: manifest 以 TSV 分发, shell 只做行解析
#   - 多源回退: jsdelivr CDN → raw.githubusercontent → uci 自定义源
#   - sha256 校验后才落地, 逐文件原子替换, 任一步失败不动现有数据
#   - 离线可用: 内置数据集随包, 无网络时一切照常

set -u

DATA_DIR="/usr/share/netsteer"
STATE_DIR="/tmp/netsteer"
LOCAL_MANIFEST="$DATA_DIR/manifest.tsv"
WORK="$STATE_DIR/feed"
FEED_HIST="/etc/netsteer/feed-history"
PHIST="/etc/netsteer/history.log"
DATA_FILES="manifest.tsv gamedomains.txt gameips.txt gameports.txt downloadports.txt streamdomains.txt"
DEFAULT_SOURCES="
https://cdn.jsdelivr.net/gh/pm-parker/netsteer@main/data
https://raw.githubusercontent.com/pm-parker/netsteer/main/data
"

log() { logger -t netsteer-feed "$*" 2>/dev/null; }
ph() { # 持久审计 (与 v1.22.1 snapshot/check 同一时间线; 2000 行滚动留 800)
	echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$PHIST" 2>/dev/null
	[ "$(wc -l < "$PHIST" 2>/dev/null)" -gt 2000 ] && tail -800 "$PHIST" > "$PHIST.tmp" 2>/dev/null && mv "$PHIST.tmp" "$PHIST"
}

# ---- 输出助手 ----
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

fetch() { # $1=url -> stdout (空=失败)
	local _url="$1"
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --max-time 25 "$_url" 2>/dev/null
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 25 -O - "$_url" 2>/dev/null
	else
		return 1
	fi
}

fetch_to() { # $1=url $2=file
	local _url="$1" _dst="$2"
	if command -v curl >/dev/null 2>&1; then
		curl -fsSL --max-time 120 -o "$_dst" "$_url" 2>/dev/null
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 120 -O "$_dst" "$_url" 2>/dev/null
	else
		return 1
	fi
}

sha_of() { # $1=file -> sha256 (空=失败)
	local _p="$1"
	[ -f "$_p" ] || return 1
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$_p" 2>/dev/null | cut -d' ' -f1
	else
		return 1
	fi
}

sources() {
	local _custom
	_custom="$(uci -q get netsteer.feed.url 2>/dev/null)"
	if [ -n "$_custom" ]; then
		printf '%s\n%s\n' "$_custom" "$DEFAULT_SOURCES"
	else
		printf '%s\n' "$DEFAULT_SOURCES"
	fi
}

# 从 manifest.tsv 读出版本行
man_version() {
	local _p="$1"
	[ -f "$_p" ] || return 1
	head -1 "$_p" 2>/dev/null | sed -n 's/.* v=\([^ ]*\) .*/\1/p'
}

# 从 manifest.tsv 读某文件 sha256
man_sha() { # $1=manifest $2=name
	local _p="$1" _n="$2"
	[ -f "$_p" ] || return 1
	awk -F'	' -v n="$_n" '$1==n {print $2; exit}' "$_p"
}

man_size() { # $1=manifest $2=name
	local _p="$1" _n="$2"
	[ -f "$_p" ] || return 1
	awk -F'	' -v n="$_n" '$1==n {print $3; exit}' "$_p"
}

man_names() { # $1=manifest
	local _p="$1"
	[ -f "$_p" ] || return 1
	awk -F'	' '$1 !~ /^#/ && NF>=2 {print $1}' "$_p"
}

# 拉远程 manifest, 落到 $WORK/manifest.tsv; 成功返回 0
pull_manifest() {
	local _s
	mkdir -p "$WORK" 2>/dev/null
	_found=1
	for _s in $(sources); do
		[ -n "$_s" ] || continue
		if fetch "$_s/manifest.tsv" > "$WORK/manifest.tsv" 2>/dev/null && [ -s "$WORK/manifest.tsv" ]; then
			# 格式校验: 首行必须含 v=
			if head -1 "$WORK/manifest.tsv" | grep -q 'v='; then
				rm -f "$WORK/source"
				printf '%s' "$_s" > "$WORK/source"
				_found=0
				break
			fi
		fi
	done
	return $_found
}

# ---- status ----
cmd_status() {
	_v="$(man_version "$LOCAL_MANIFEST" 2>/dev/null || echo '-')"
	_items=""
	_ok=1
	_manifest_files=""
	if [ -f "$LOCAL_MANIFEST" ]; then
		_manifest_files="$(man_names "$LOCAL_MANIFEST")"
	fi
	if [ -z "$_manifest_files" ]; then
		# 包内无 manifest (老包): 列目录里的数据文件
		for _f in gamedomains.txt gameips.txt gameports.txt downloadports.txt streamdomains.txt; do
			[ -f "$DATA_DIR/$_f" ] && _manifest_files="$_manifest_files $_f"
		done
	fi
	for _f in $_manifest_files; do
		_want="$(man_sha "$LOCAL_MANIFEST" "$_f" 2>/dev/null)"
		_got="$(sha_of "$DATA_DIR/$_f")"
		_st="ok"
		if [ -z "$_want" ]; then _st="unmanaged"; elif [ "$_want" != "$_got" ]; then _st="modified"; _ok=0; fi
		[ -n "$_items" ] && _items="$_items,"
		_items="$_items{\"file\":\"$(esc "$_f")\",\"status\":\"$_st\"}"
	done
	printf '{"installed_version":"%s","integrity":%s,"files":[%s]}\n' \
		"$(esc "$_v")" "$([ "$_ok" = 1 ] && echo true || echo false)" "$_items"
}

# ---- 语义自检 (v1.22.2 P1): sha256 保证传输完整, 这里保证语义正确 — 格式坏=引擎静默降级 ----
# $1=file → 0=通过; 输出理由到 stdout
validate_data() {
	local _f="$1" _base _cat _val _n=0 _bad=0
	[ -s "$_f" ] || { echo "空文件"; return 1; }
	_base=$(basename "$_f")
	case "$_base" in
	gamedomains.txt|streamdomains.txt) # cat TAB 域名后缀
		while IFS= read -r _line || [ -n "$_line" ]; do
			_line=$(printf '%s' "$_line" | sed 's/#.*//' | sed 's/^[ 	]*//; s/[ 	]*$//')
			[ -z "$_line" ] && continue
			_val=$(printf '%s' "$_line" | sed 's/^[^	 ]*[	 ]*//')
			case "$_val" in ''|*[!a-z0-9.*-]*) _bad=$((_bad+1)); continue ;; esac
			_n=$((_n+1))
		done < "$_f"
		;;
	gameips.txt) # cat TAB CIDR
		while IFS= read -r _line || [ -n "$_line" ]; do
			_line=$(printf '%s' "$_line" | sed 's/#.*//' | sed 's/^[ \t]*//; s/[ \t]*$//')
			[ -z "$_line" ] && continue
			_val=$(printf '%s' "$_line" | sed 's/^[^\t ]*[\t ]*//')
			case "$_val" in *[!0-9./]*) _bad=$((_bad+1)); continue ;; esac
			case "$_val" in *.*) _n=$((_n+1));; *) _bad=$((_bad+1)); continue ;; esac
		done < "$_f"
		;;
	gameports.txt|downloadports.txt) # cat TAB lo-hi/proto 或 单端口/proto (实测 4662/tcp 单值形态)
		while IFS= read -r _line || [ -n "$_line" ]; do
			_line=$(printf '%s' "$_line" | sed 's/#.*//' | sed 's/^[ 	]*//; s/[ 	]*$//')
			[ -z "$_line" ] && continue
			_val=$(printf '%s' "$_line" | sed 's/^[^	 ]*[	 ]*//')
			_proto=${_val##*/}
			_ports=${_val%%/*}
			[ "$_proto" = "$_val" ] && { _bad=$((_bad+1)); continue; }   # 无 /proto
			case "$_proto" in tcp|udp) ;; *) _bad=$((_bad+1)); continue ;; esac
			case "$_ports" in ''|*[!0-9-]*) _bad=$((_bad+1)); continue ;; esac
			_n=$((_n+1))
		done < "$_f"
		;;
	esac
	[ "$_bad" -gt 0 ] && { echo "$_bad 行格式非法"; return 1; }
	[ "$_n" -lt 1 ] && { echo "无有效数据行"; return 1; }
	return 0
}

# ---- 引擎冒烟 (v1.22.2 P1): 合成七字段 TSV 行喂判定引擎, 输出须含合法 scene ----
smoke_engine() {
	local _out _short
	# 引擎文件缺失 (异常环境/单测最小装机): 跳过冒烟 — 数据正确性已由 validate_data 承担
	[ -f "$DATA_DIR/sense.awk" ] || return 0
	_out=$(printf '5000	udp	192.168.1.10	111.111.111.111	27015	500	stun.example.com' \
		| awk -f "$DATA_DIR/sense.awk" 2>/dev/null) || { echo "引擎执行失败"; return 1; }
	case "$_out" in
		*'"scene"'*) return 0 ;;
		*) _short=$(printf '%s' "$_out" | cut -c1-60); echo "引擎输出异常: $_short"; return 1 ;;
	esac
}

# feed 版本化历史: 更新前整目录快照, 保留 20 份
hist_save() {
	local _ts _id _f
	_ts=$(date +%Y%m%d-%H%M%S)
	# 同秒冲突防线: cron/手动同秒各存一份时秒级 ts 会撞 — $$ (PID) 保证 id 唯一 (真机实测踩过)
	_id="${_ts}-$(man_version "$LOCAL_MANIFEST" 2>/dev/null | tr ':.' '--' | cut -c1-20)-$$"
	mkdir -p "$FEED_HIST/$_id" 2>/dev/null || return 1
	for _f in $DATA_FILES; do
		[ -f "$DATA_DIR/$_f" ] && cp -f "$DATA_DIR/$_f" "$FEED_HIST/$_id/$_f" 2>/dev/null
	done
	ls -1 "$FEED_HIST" 2>/dev/null | sort -r | tail -n +21 | while read -r _old; do
		rm -rf "$FEED_HIST/$_old"
	done
	echo "$_id"
}

# ---- check ----
cmd_check() {
	if ! pull_manifest; then
		printf '{"error":"no_source","detail":"所有数据源不可达"}\n'
		return 1
	fi
	_src="$(cat "$WORK/source" 2>/dev/null)"
	_rv="$(man_version "$WORK/manifest.tsv" 2>/dev/null || echo '-')"
	_lv="$(man_version "$LOCAL_MANIFEST" 2>/dev/null || echo '-')"
	_changed=""
	_n=0
	for _f in $(man_names "$WORK/manifest.tsv"); do
		_rsha="$(man_sha "$WORK/manifest.tsv" "$_f")"
		_lsha="$(man_sha "$LOCAL_MANIFEST" "$_f" 2>/dev/null)"
		[ -z "$_lsha" ] && _lsha="$(sha_of "$DATA_DIR/$_f")"
		if [ "$_rsha" != "$_lsha" ]; then
			[ -n "$_changed" ] && _changed="$_changed,"
			_changed="$_changed{\"file\":\"$(esc "$_f")\",\"remote_sha256\":\"$_rsha\"}"
			_n=$((_n + 1))
		fi
	done
	printf '{"remote_version":"%s","installed_version":"%s","source":"%s","update_available":%s,"changed":[%s]}\n' \
		"$(esc "$_rv")" "$(esc "$_lv")" "$(esc "$_src")" \
		"$([ "$_n" -gt 0 ] && echo true || echo false)" "$_changed"
	return 0
}

# ---- update ----
cmd_update() {
	if ! pull_manifest; then
		printf '{"error":"no_source","detail":"所有数据源不可达, 保持现有数据集"}\n'
		return 1
	fi
	_src="$(cat "$WORK/source" 2>/dev/null)"
	_rv="$(man_version "$WORK/manifest.tsv" 2>/dev/null || echo '-')"
	_mkdir_ok=0
	mkdir -p "$WORK/dl" "$WORK/stage" 2>/dev/null && _mkdir_ok=1
	if [ "$_mkdir_ok" != 1 ]; then
		printf '{"error":"no_tmp","detail":"无法创建临时目录 %s"}\n' "$WORK/dl"
		return 1
	fi
	_updated=""
	_n=0
	_failed=""
	for _f in $(man_names "$WORK/manifest.tsv"); do
		_rsha="$(man_sha "$WORK/manifest.tsv" "$_f")"
		_rsize="$(man_size "$WORK/manifest.tsv" "$_f")"
		_lsha="$(man_sha "$LOCAL_MANIFEST" "$_f" 2>/dev/null)"
		[ -z "$_lsha" ] && _lsha="$(sha_of "$DATA_DIR/$_f")"
		[ "$_rsha" = "$_lsha" ] && continue
		if ! fetch_to "$_src/$_f" "$WORK/dl/$_f"; then
			_failed="$_failed$_f(download),"
			continue
		fi
		_got="$(sha_of "$WORK/dl/$_f")"
		if [ "$_got" != "$_rsha" ]; then
			_failed="$_failed$_f(sha256),"
			continue
		fi
		if [ -n "$_rsize" ]; then
			_gotsz="$(wc -c < "$WORK/dl/$_f" 2>/dev/null | tr -d ' ')"
			[ "$_gotsz" = "$_rsize" ] || { _failed="$_failed$_f(size),"; continue; }
		fi
		# v1.22.2 P1: 语义自检 — sha 对但格式坏的数据不落地 (引擎静默降级防线)
		if ! _vmsg="$(validate_data "$WORK/dl/$_f")"; then
			_failed="$_failed$_f(validate:$_vmsg),"
			continue
		fi
		cp -f "$WORK/dl/$_f" "$WORK/stage/$_f" 2>/dev/null
		_updated="$_updated{\"file\":\"$(esc "$_f")\",\"sha256\":\"$_rsha\"},"
		_n=$((_n + 1))
	done
	_updated=${_updated%,}   # 上面逗号后缀统一收尾
	if [ "$_n" -gt 0 ]; then
		# v1.22.2 P4: 版本化快照 (整目录进 /etc/netsteer/feed-history, 20 份; 回滚可回滚)
		_hist_id=$(hist_save)
		# stage → 现场原子替换 + manifest 同步
		for _f in $DATA_FILES; do
			[ -f "$WORK/stage/$_f" ] || continue
			cp -f "$WORK/stage/$_f" "$DATA_DIR/.${_f}.new" 2>/dev/null || { _failed="$_failed$_f(commit),"; continue; }
			chmod 644 "$DATA_DIR/.${_f}.new" 2>/dev/null
			mv -f "$DATA_DIR/.${_f}.new" "$DATA_DIR/$_f" 2>/dev/null || { _failed="$_failed$_f(commit),"; continue; }
		done
		cp -f "$WORK/manifest.tsv" "$DATA_DIR/.manifest.tsv.new" 2>/dev/null && \
			mv -f "$DATA_DIR/.manifest.tsv.new" "$LOCAL_MANIFEST" 2>/dev/null
		rm -f "$DATA_DIR"/*.bak 2>/dev/null   # 旧 .bak 机制退役, 历史走 feed-history
		# v1.22.2 P1: 冒烟 — 替换后引擎必须还能出合法判定, 否则整包自动回滚
		if ! _smsg="$(smoke_engine)"; then
			for _f in $DATA_FILES; do
				[ -f "$FEED_HIST/$_hist_id/$_f" ] && cp -f "$FEED_HIST/$_hist_id/$_f" "$DATA_DIR/$_f" 2>/dev/null
			done
			ph "feed update 冒烟失败已自动回滚: $_smsg (版本 $_rv)"
			log "update smoke FAILED auto-rolled-back: $_smsg ver=$_rv"
			printf '{"error":"smoke_failed","detail":"%s","rolled_back":"%s"}\n' "$(esc "$_smsg")" "$(esc "$_hist_id")"
			return 3
		fi
		ph "feed update 版本 $_rv: $_n 文件 (回滚点 $_hist_id)"
	fi
	printf '{"updated":[%s],"count":%d,"version":"%s","source":"%s"%s}\n' \
		"$_updated" "$_n" "$(esc "$_rv")" "$(esc "$_src")" \
		"$( [ -n "$_failed" ] && printf ',"failed":"%s"' "$(esc "$_failed")" )"
	log "feed update: version=$_rv updated=$_n failed=${_failed:-none} src=$_src"
	[ -n "$_failed" ] && return 2
	return 0
}

# ---- rollback ----
# v1.22.2: 主路径 = feed-history 版本化回滚 (restore <id|latest>); 旧 .bak 单代回退保留兼容
cmd_rollback() {
	_id="${2:-latest}"
	if [ "$_id" = "latest" ]; then
		_id=$(ls -1 "$FEED_HIST" 2>/dev/null | sort -r | head -1)
	fi
	if [ -n "$_id" ] && [ -d "$FEED_HIST/$_id" ]; then
		_n=0; _restored=""
		# 先锁定目标 id 再存 pre (顺序 bug 教训: 先存 pre 会让 latest 解析到 pre 自己=恢复污染态)
		_pre=$(hist_save)
		for _f in $DATA_FILES; do
			[ -f "$FEED_HIST/$_id/$_f" ] || continue
			cp -f "$FEED_HIST/$_id/$_f" "$DATA_DIR/.${_f}.new" 2>/dev/null || continue
			mv -f "$DATA_DIR/.${_f}.new" "$DATA_DIR/$_f" 2>/dev/null || continue
			_restored="$_restored{\"file\":\"$(esc "$_f")\"},"
			_n=$((_n + 1))
		done
		_restored=${_restored%,}
		if ! _smsg="$(smoke_engine)"; then
			printf '{"error":"smoke_failed","detail":"%s"}\n' "$(esc "$_smsg")"
			return 3
		fi
		ph "feed rollback → $_id ($_n 文件, 回滚前存 $_pre)"
		log "feed rollback: → $_id restored=$_n"
		printf '{"restored":[%s],"count":%d,"from":"%s","pre":"%s"}\n' "$_restored" "$_n" "$(esc "$_id")" "$(esc "$_pre")"
		return 0
	fi
	# 兼容: 旧 .bak 单代回退
	_restored=""
	_n=0
	for _f in gamedomains.txt gameips.txt gameports.txt downloadports.txt streamdomains.txt; do
		[ -f "$DATA_DIR/$_f.bak" ] || continue
		cp -f "$DATA_DIR/$_f.bak" "$DATA_DIR/.${_f}.new" 2>/dev/null || continue
		mv -f "$DATA_DIR/.${_f}.new" "$DATA_DIR/$_f" 2>/dev/null || continue
		rm -f "$DATA_DIR/$_f.bak"
		_restored="$_restored{\"file\":\"$(esc "$_f")\"}"
		_n=$((_n + 1))
	done
	if [ -f "$LOCAL_MANIFEST.bak" ]; then
		cp -f "$LOCAL_MANIFEST.bak" "$LOCAL_MANIFEST" 2>/dev/null && rm -f "$LOCAL_MANIFEST.bak"
	fi
	printf '{"restored":[%s],"count":%d}\n' "$_restored" "$_n"
	[ "$_n" -gt 0 ] && log "feed rollback: restored $_n files"
	return 0
}

# ---- auto (v1.22.2 P2): cron 每周调用 — check→有更新→update→审计; uci 开关 netsteer.feed.auto ----
cmd_auto() {
	[ "$(uci -q get netsteer.feed.auto 2>/dev/null || echo 1)" = "1" ] || exit 0   # 宁可显式关, 默认开
	if ! pull_manifest; then
		log "auto: 所有数据源不可达, 保持现状"
		ph "feed auto: 源不可达, 保持现状"
		exit 1
	fi
	_rv="$(man_version "$WORK/manifest.tsv" 2>/dev/null || echo '-')"
	_lv="$(man_version "$LOCAL_MANIFEST" 2>/dev/null || echo '-')"
	if [ "$_rv" = "$_lv" ]; then
		# 版本相同仍比对文件 sha (远端可能热修)
		_diff=0
		for _f in $(man_names "$WORK/manifest.tsv"); do
			[ "$(man_sha "$WORK/manifest.tsv" "$_f")" != "$(sha_of "$DATA_DIR/$_f" 2>/dev/null)" ] && _diff=1 && break
		done
		[ "$_diff" = "0" ] && { log "auto: 已是最新 ($_rv)"; exit 0; }
	fi
	log "auto: 发现更新 $_lv → $_rv, 开始 update"
	_out=$(cmd_update); _rc=$?
	_out_short=$(printf '%s' "$_out" | cut -c1-120)
	ph "feed auto: $_lv → $_rv rc=$_rc $_out_short"
	log "auto update rc=$_rc $_out_short"
	exit $_rc
}

case "${1:-status}" in
	status)   cmd_status;;
	check)    cmd_check;;
	update)   shift; cmd_update;;
	auto)     cmd_auto;;
	rollback) shift; cmd_rollback "$@";;
	*)        echo "usage: netsteer-feed {status|check|update|auto|rollback [id]}" >&2; exit 2;;
esac
